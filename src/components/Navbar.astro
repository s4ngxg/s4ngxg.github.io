---
import { Icon } from "astro-icon/components";

interface Props { active?: "home" | "archive" | "about" }
const { active } = Astro.props;
---
<nav class="navbar" aria-label="Điều hướng chính">
  <a class="brand" href="/">
    <span class="brand-symbol" aria-hidden="true"><Icon name="fa6-solid:house" /></span>
    <span><b>s4ngxg</b></span>
  </a>
  <div class="nav-links" id="navLinks">
    <a class:list={[{ active: active === "home" }]} aria-current={active === "home" ? "page" : undefined} href="/"><Icon name="fa6-solid:house" /><span>Home</span></a>
    <a class:list={[{ active: active === "archive" }]} aria-current={active === "archive" ? "page" : undefined} href="/archive/#content"><Icon name="fa6-solid:box-archive" /><span>Archive</span></a>
    <a class:list={[{ active: active === "about" }]} aria-current={active === "about" ? "page" : undefined} href="/about/#content"><Icon name="fa6-solid:address-card" /><span>About</span></a>
  </div>
  <div class="nav-tools">
    {active === "home" && <button class="tool-button search-open" type="button" aria-label="Tìm kiếm"><svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="6.5"></circle><path d="m16 16 4 4"></path></svg></button>}
    <button class="tool-button theme-button" type="button" aria-label="Đổi giao diện"><span class="theme-glyph" aria-hidden="true">☾</span></button>
    <button class="tool-button menu-button" type="button" aria-label="Mở menu" aria-expanded="false"><svg viewBox="0 0 24 24"><path d="M4 7h16M4 12h16M4 17h16"></path></svg></button>
  </div>
</nav>
