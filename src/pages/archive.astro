---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import SiteSidebar from "../components/SiteSidebar.astro";
import { formatDate, getSortedPosts, postUrl } from "../utils/posts";

const posts = await getSortedPosts();
const years = [...new Set(posts.map((post) => post.data.published.getFullYear()))];
---
<BaseLayout title="Archive — s4ngxg" description="Kho bài viết của s4ngxg về An toàn thông tin, CTF và Web3 Security.">
  <header class="subpage-hero" id="top">
    <img class="hero-image hero-image-day" src="/assets/hero-day.webp" alt="Góc viết bên cửa sổ vào ban ngày" />
    <img class="hero-image hero-image-night" src="/assets/hero-night.webp" alt="Góc viết bên cửa sổ vào ban đêm" />
  </header>
  <Navbar active="archive" />
  <main class="layout subpage-layout" id="content">
    <SiteSidebar />
    <div class="subpage-content archive-content">
      {years.map((year) => (
        <section class="archive-year reveal" aria-labelledby={`year-${year}`}>
          <h2 id={`year-${year}`}>{year}</h2>
          <div class="archive-list">
            {posts.filter((post) => post.data.published.getFullYear() === year).map((post) => (
              <a class="archive-item" data-category={post.data.category} data-tags={post.data.tags.join("|")} href={postUrl(post)}><time datetime={post.data.published.toISOString()}>{formatDate(post.data.published, "archive")}</time><h3>{post.data.title}</h3><span>→</span></a>
            ))}
          </div>
        </section>
      ))}
    </div>
  </main>
  <Footer />
</BaseLayout>
