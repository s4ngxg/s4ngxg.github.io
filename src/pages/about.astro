---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import SiteSidebar from "../components/SiteSidebar.astro";
---
<BaseLayout title="About — s4ngxg" description="Trang web ghi lại những gì s4ngxg học tập.">
  <header class="subpage-hero" id="top">
    <img class="hero-image hero-image-day" src="/assets/hero-day.webp" alt="Góc viết bên cửa sổ vào ban ngày" />
    <img class="hero-image hero-image-night" src="/assets/hero-night.webp" alt="Góc viết bên cửa sổ vào ban đêm" />
  </header>
  <Navbar active="about" />
  <main class="layout subpage-layout" id="content">
    <SiteSidebar />
    <div class="subpage-content about-content">
      <section class="about-copy-page card reveal">
        <p>Tôi là <strong>s4ngxg</strong>. Đây là trang web để ghi lại những gì tôi học tập.</p>
      </section>
    </div>
  </main>
  <Footer />
</BaseLayout>
