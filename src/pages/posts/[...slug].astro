---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import TableOfContents from "../../components/TableOfContents.astro";
import { formatDate, getSortedPosts, postUrl, readingTime, type Post } from "../../utils/posts";

export async function getStaticPaths() {
  const posts = await getSortedPosts();
  return posts.map((entry) => ({ params: { slug: entry.slug }, props: { entry, posts } }));
}

interface Props { entry: Post; posts: Post[] }
const { entry, posts } = Astro.props;
const { Content, headings } = await entry.render();
const minutes = readingTime(entry.body);
const index = posts.findIndex((post) => post.id === entry.id);
const previousPost = posts[index + 1];
const nextPost = posts[index - 1];
---
<BaseLayout title={`${entry.data.title} — s4ngxg`} description={entry.data.description || entry.data.title}>
  <header class="article-hero" id="top">
    <img class="hero-image hero-image-day" src="/assets/hero-day.webp" alt="Góc ghi chép dưới ánh sáng ban ngày" />
    <img class="hero-image hero-image-night" src="/assets/hero-night.webp" alt="Bầu trời sao và góc ghi chép" />
    <a class="article-back" href="/">← Trở về s4ngxg</a>
    <div class="article-title" id="reading-start"><p>{formatDate(entry.data.published)} · {minutes} PHÚT ĐỌC</p><h1>{entry.data.title}</h1></div>
  </header>
  <Navbar active="archive" />
  <main class="article-layout" id="content">
    <div class="article-reading">
      <article class="article-card markdown-content custom-md">
        {entry.data.lead && <p class="lead">{entry.data.lead}</p>}
        <Content />
      </article>
      {(previousPost || nextPost) && (
        <nav class="article-pagination" aria-label="Bài viết trước và sau">
          {previousPost && <a class="previous" href={postUrl(previousPost)}><span>← BÀI TRƯỚC</span><small>{previousPost.data.category.toUpperCase()}</small><b>{previousPost.data.title}</b></a>}
          {nextPost && <a class="next" href={postUrl(nextPost)}><span>BÀI TIẾP THEO →</span><small>{nextPost.data.category.toUpperCase()}</small><b>{nextPost.data.title}</b></a>}
        </nav>
      )}
    </div>
    <TableOfContents headings={headings} />
  </main>
  <Footer />
</BaseLayout>
